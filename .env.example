# Copy this file to .env for local development and fill in real values.
# Never commit your actual .env file.
#
# Only two external API keys are needed — no database/cloud account required.

OWM_API_KEY=your_openweathermap_api_key
AQICN_TOKEN=your_aqicn_token

CITY_NAME=Lahore
CITY_LAT=31.5497
CITY_LON=74.3436

# Optional: Slack/Discord/ntfy.sh webhook for hazardous AQI alerts
ALERT_WEBHOOK_URL=
